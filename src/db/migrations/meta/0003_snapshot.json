        "account_transactions_reason_required_check": {
          "name": "account_transactions_reason_required_check",
          "value": "(\"account_transactions\".\"transaction_type\" NOT IN ('adjustment_increase', 'adjustment_decrease', 'reversal')) OR length(trim(coalesce(\"account_transactions\".\"reason\", ''))) > 0"
