        },
        "account_transactions_transfer_link_check": {
          "name": "account_transactions_transfer_link_check",
          "value": "(\"account_transactions\".\"transaction_type\" NOT IN ('transfer_in', 'transfer_out')) OR \"account_transactions\".\"transfer_id\" IS NOT NULL"
