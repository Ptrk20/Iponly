{
  "name": "iponly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import=tsx src/db/scripts/check-env.ts && drizzle-kit migrate",
    "db:studio": "node --conditions=react-server --import=tsx src/db/scripts/check-env.ts && drizzle-kit studio",
    "db:health": "node --conditions=react-server --import=tsx src/db/scripts/health-check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.159",
    "better-auth": "^1.7.14",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
